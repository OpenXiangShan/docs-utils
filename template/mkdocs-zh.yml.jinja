site_name: '[[ site_name_zh ]]'

repo_url: https://github.com/[[ github_owner ]]/[[ repository_name ]]

repo_name: '[[ repository_name ]]'

docs_dir: docs/zh

site_dir: site/zh

copyright: |
  <div>XiangShan Documents are licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</div>
  <div>Copyright © 2024 - 2026 The XiangShan Team, Beijing Institute of Open Source Chip</div>

theme:
  name: material
  custom_dir: tools/mkdocs_theme
  features:
    - navigation.indexes
    - navigation.top
    - navigation.footer
    - content.action.edit
    - content.action.view
  language: zh

extra_css:
  - assets/stylesheets/table_fix.css

extra_javascript:
  - assets/javascripts/mathjax.js
  - https://unpkg.com/mathjax@3/es5/tex-mml-chtml.js

markdown_extensions:
  admonition: {}
  pymdownx.details: {}
  pymdownx.superfences: {}
  pymdownx.arithmatex:
    generic: true
  footnotes: {}
  abbr: {}
  pymdownx.snippets: {}
  attr_list: {}
  md_in_html: {}
  def_list: {}
  markdown_grid_tables: {}
  markdown_captions: {}
  table_captions: {}
  crossref:
    enable_ref_group: false
    enable_ref_number: false
    remove_ref_types:
      - sec
    figPrefix: 此图
    tblPrefix: 此表
    secPrefix: 此节
    refDelim: 、
    groupDelim: 、
  remove_include: {}
  replace_variables:
    yaml_file: docs/variables-zh.yml

plugins:
  search:
    lang: zh

extra:
  social:
    - icon: fontawesome/solid/house
      link: https://xiangshan.cc/
      name: XiangShan Homepage
    - icon: material/file-document-multiple
      link: https://docs.xiangshan.cc
      name: XiangShan Documents
    - icon: fontawesome/brands/github
      link: https://github.com/OpenXiangShan
      name: XiangShan on GitHub
  readthedocs_version: true
  back_to_home:
    url: https://docs.xiangshan.cc/
    icon: material/file-document-multiple
    title: 回到香山文档首页
  alternate:
    - name: 中文
      link: https://docs.xiangshan.cc/projects/[[ docs_project_slug ]]/zh-cn/latest/
      lang: zh
    - name: English
      link: https://docs.xiangshan.cc/projects/[[ docs_project_slug ]]/en/latest/
      lang: en

nav:
  - 首页: index.md
  - 开始使用: getting-started.md
